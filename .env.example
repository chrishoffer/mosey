# Mosey — client environment (safe to expose; these ship in the app bundle)
# Copy to .env and fill with your fresh Supabase project's values.
# NEVER put ANTHROPIC_API_KEY here — it lives in Supabase secrets only.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Amazon Associates is deferred for v1 (see FUTURE.md). When re-enabled, add:
# EXPO_PUBLIC_AMAZON_ASSOCIATE_TAG=yourtag-20
